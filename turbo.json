{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "OMNISYNC_TEST_DATABASE_URL",
        "STORM_CLIENTS",
        "PLAYWRIGHT_BROWSERS_PATH",
        "OMNISYNC_REQUIRE_BROWSER",
        "OMNISYNC_TEST_S3_ENDPOINT",
        "OMNISYNC_REQUIRE_S3"
      ]
    }
  },
  "agentGuidance": false
}
