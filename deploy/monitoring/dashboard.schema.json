{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "What the OmniSync dashboard relies on from Grafana's dashboard JSON",
  "type": "object",
  "required": ["uid", "title", "schemaVersion", "time", "refresh", "templating", "panels"],
  "properties": {
    "uid": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
    "title": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "integer", "minimum": 36 },
    "refresh": { "type": "string", "pattern": "^[0-9]+[smh]$" },
    "time": { "type": "object", "required": ["from", "to"], "properties": { "from": { "type": "string" }, "to": { "type": "string" } } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "templating": {
      "type": "object",
      "required": ["list"],
      "properties": {
        "list": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "required": ["name", "type"], "properties": { "name": { "type": "string" }, "type": { "enum": ["datasource", "query", "custom"] } } }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "gridPos"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "type": { "enum": ["row", "stat", "timeseries"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "gridPos": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer", "minimum": 0, "maximum": 23 },
              "y": { "type": "integer", "minimum": 0 },
              "w": { "type": "integer", "minimum": 1, "maximum": 24 },
              "h": { "type": "integer", "minimum": 1, "maximum": 24 }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "enum": ["stat", "timeseries"] } } },
            "then": {
              "required": ["datasource", "targets", "fieldConfig"],
              "properties": {
                "datasource": { "type": "object", "required": ["type", "uid"], "properties": { "type": { "const": "prometheus" }, "uid": { "const": "${datasource}" } } },
                "targets": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "object", "required": ["expr", "refId", "datasource"], "properties": { "expr": { "type": "string", "minLength": 1 }, "refId": { "type": "string", "pattern": "^[A-Z]$" } } }
                },
                "fieldConfig": {
                  "type": "object",
                  "required": ["defaults"],
                  "properties": { "defaults": { "type": "object", "required": ["unit", "thresholds"], "properties": { "unit": { "type": "string" }, "thresholds": { "type": "object", "required": ["mode", "steps"] } } } }
                }
              }
            }
          }
        ]
      }
    }
  }
}
