{
  "name": "omnisync",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=4",
    "lint": "eslint .",
    "bench": "pnpm --filter @omnisync/bench run bench",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
