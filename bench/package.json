{
  "name": "@omnisync/bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node --expose-gc --import tsx src/run.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "load": "node --expose-gc --import tsx src/load.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@omnisync/engine": "workspace:*",
    "@omnisync/gateway": "workspace:*",
    "@omnisync/protocol": "workspace:*",
    "@omnisync/store": "workspace:*",
    "@omnisync/telemetry": "workspace:*",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@omnisync/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2"
  }
}
