{
  "name": "@omnisync/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Sync gateway: certificate-authenticated, durable, signed updates",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "serve": "node dist/serve.js",
    "export": "node dist/export-cli.js"
  },
  "dependencies": {
    "@omnisync/crypto": "workspace:*",
    "@omnisync/engine": "workspace:*",
    "@omnisync/protocol": "workspace:*",
    "@omnisync/store": "workspace:*",
    "@omnisync/telemetry": "workspace:*",
    "@omnisync/verifier": "workspace:*",
    "ws": "^8.22.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@omnisync/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pg": "^8.23.1"
  }
}
