{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "reference-app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "config.json", "input": "public" }],
            "styles": ["src/styles.css"],
            "outputPath": { "base": "dist", "browser": "" }
          },
          "configurations": {
            "production": {
              "outputHashing": "none",
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
              "budgets": [{ "type": "initial", "maximumWarning": "900kB", "maximumError": "1.5MB" }]
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": { "production": { "buildTarget": "reference-app:build:production" }, "development": { "buildTarget": "reference-app:build:development" } },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
